# AI News Intelligence System Configuration

# Vector Database Path
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=news_knowledge_base

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Configuration (If using OpenAI / Anthropic or fallback local/mock LLM)
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini

# Chunking & Processing Configuration
CHUNK_SIZE=400
CHUNK_OVERLAP=50
MAX_ARTICLES_PER_FEED=10
RECENCY_DECAY_LAMBDA=0.05

# Log Level
LOG_LEVEL=INFO
